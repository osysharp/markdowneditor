{
  // Type-checking ONLY — esbuild does the emit, and it strips types without looking at them. Without this, a shim
  // can disagree with the ABI the platform generated for it and nothing says so until a browser.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts", "**/*.d.ts"]
}
