    "@lezer/highlight": "^1.2.1",
    "@milkdown/kit": "^7.21.3",
    "esbuild": "^0.28.1",
    "mermaid": "^11.16.0",
    "remark-math": "^6.0.0",
    "temml": "^0.13.4",
    "typescript": "^5.9.3"
